{
  "info": {
    "name": "PulseNotify \u2014 13 assignment scenarios",
    "description": "Run in order; configure admin credentials before 12; wait for Beat before 13. Scenario 13 also requires a manual PGAdmin row check. See README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "FlightAlerts!925",
      "type": "string"
    },
    {
      "key": "access",
      "value": "",
      "type": "string"
    },
    {
      "key": "alert_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "deactivate_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_username",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_access",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Register a new user (role injection ignored)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register/",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('username', 'pulse_' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 14));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const registrationBody = pm.response.json();",
              "pm.test('JWT returned and role is user', () => { pm.expect(registrationBody.access).to.be.a('string'); pm.expect(registrationBody.role).to.eql('user'); });",
              "pm.collectionVariables.set('access', registrationBody.access);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Duplicate username",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register/",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login with valid credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login/",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"role\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('access', pm.response.json().access);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Login with wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/login/",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create alert without token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/alerts/",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": \"7000.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Create an alert with JWT (guaranteed threshold hit)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/alerts/",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": \"7000.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('alert_id', pm.response.json().id);",
              "pm.test('Initially active', () => pm.expect(pm.response.json().status).to.eql('active'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 List own alerts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/alerts/",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Own alert present', () => { const rows = pm.response.json(); pm.expect(rows).to.be.an('array'); pm.expect(rows.some(x => String(x.id) === String(pm.collectionVariables.get('alert_id')))).to.be.true; });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Deactivate a disposable alert (preserve scenario 06)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/alerts/{{deactivate_id}}/",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({url: pm.collectionVariables.get('base_url') + '/api/alerts/', method: 'POST', header: {'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.collectionVariables.get('access')}, body: {mode: 'raw', raw: JSON.stringify({origin: 'DEL', destination: 'BOM', threshold_price: '0.01'})}}, (err, res) => {",
              "  if (err || res.code !== 201) throw new Error('Could not create disposable alert');",
              "  pm.collectionVariables.set('deactivate_id', res.json().id);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Inactive status', () => pm.expect(pm.response.json().status).to.eql('inactive'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Mock feed with valid route",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/flights/price/?route=DEL-BOM",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Integer price within range', () => { const d = pm.response.json(); pm.expect(d.route).to.eql('DEL-BOM'); pm.expect(Number.isInteger(d.price)).to.be.true; pm.expect(d.price).to.be.within(3000, 7000); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Mock feed with invalid route",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/flights/price/?route=XYZ-ABC",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Summary forbidden for regular user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/summary/",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Summary allowed for admin",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/summary/",
        "description": "Set local admin credentials first. See README for role promotion.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const username = pm.collectionVariables.get('admin_username'); const password = pm.collectionVariables.get('admin_password');",
              "if (!username || !password) throw new Error('Set admin_username/admin_password after promoting the account with manage.py set_role');",
              "pm.sendRequest({url: pm.collectionVariables.get('base_url') + '/api/auth/login/', method: 'POST', header: {'Content-Type': 'application/json'}, body: {mode: 'raw', raw: JSON.stringify({username, password})}}, (err, res) => {",
              "  if (err || res.code !== 200 || res.json().role !== 'admin') throw new Error('Admin login failed or profile role is not admin');",
              "  pm.collectionVariables.set('admin_access', res.json().access);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Summary fields', () => { const d = pm.response.json(); ['total_alerts', 'active_alerts', 'triggered_alerts', 'total_notifications'].forEach(k => pm.expect(d[k]).to.be.a('number')); pm.expect(d.top_routes).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Verify notification after Beat fires + manual PGAdmin evidence",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/summary/",
        "description": "Wait 60\u201390 seconds with Beat and worker running before this request. This count is supporting evidence. REQUIRED: use the README SQL in PGAdmin with collection alert_id to verify that exact alert has one NotificationLog and triggered status. Capture the row as submission evidence.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('At least one notification exists', () => pm.expect(pm.response.json().total_notifications).to.be.at.least(1));"
            ]
          }
        }
      ]
    }
  ]
}
